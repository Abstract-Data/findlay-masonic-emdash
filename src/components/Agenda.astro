---
import type { BodyView } from "@adapters/site/views";
import type { AgendaDay } from "@core/calendar/month";
import type { BodyId, EntryId } from "@core/ids";
import type { EventSeries } from "@core/recurrence/series";
import { formatLongDay } from "@core/time";
import Entry from "./Entry.astro";

// The month grid as a list, and the body page's upcoming events: the readable view on a phone
// and for screen readers.
interface Props {
	days: readonly AgendaDay[];
	bodies: ReadonlyMap<BodyId, BodyView>;
	series: ReadonlyMap<EntryId, EventSeries>;
	showBody: boolean;
	empty: string;
	headingLevel?: 2 | 3 | 4;
}

const { days, bodies, series, showBody, empty, headingLevel = 3 } = Astro.props;
const Day = `h${headingLevel}` as const;
---

{days.length === 0 ? (
	<p class="agenda__empty" data-testid="agenda-empty">
		{empty}
	</p>
) : (
	<ol class="agenda" data-testid="agenda">
		{days.map((day) => (
			<li class="agenda__day">
				<Day class="agenda__date">
					<time datetime={day.date.toString()}>{formatLongDay(day.date)}</time>
				</Day>
				<ul class="agenda__entries">
					{day.occurrences.map((o) => (
						<Entry
							occurrence={o}
							body={bodies.get(o.body)}
							showBody={showBody}
							location={series.get(o.event)?.location ?? null}
						/>
					))}
				</ul>
			</li>
		))}
	</ol>
)}

<style>
	.agenda,
	.agenda__entries {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.agenda {
		display: grid;
		gap: var(--spacing-4);
	}

	.agenda__day {
		display: grid;
		grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
		gap: var(--spacing-2) var(--spacing-5);
		align-items: start;
	}

	.agenda__date {
		padding-top: var(--spacing-2);
		font-size: var(--font-size-base);
	}

	.agenda__entries {
		display: grid;
		gap: var(--spacing-2);
	}

	.agenda__empty {
		color: var(--color-text-secondary);
	}

	@media (max-width: 640px) {
		.agenda__day {
			grid-template-columns: minmax(0, 1fr);
		}

		.agenda__date {
			padding-top: 0;
		}
	}
</style>

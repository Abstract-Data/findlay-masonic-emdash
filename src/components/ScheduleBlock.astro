---
import { datetimeOf } from "@core/calendar/month";
import { formatOccurrence } from "@core/recurrence/describe";
import type { Meetings } from "@core/recurrence/meetings";

// FR-1.1, 1.3, 1.4: the schedule from the stated meeting's rule, then the next meetings.
interface Props {
	meetings: Meetings;
	/** Where to write to the body, when its contact form is set up. */
	contactHref: string | null;
}

const { meetings, contactHref } = Astro.props;
const { schedule, next } = meetings;
---

<div class="schedule" data-testid="schedule">
	{schedule.kind === "rule" && <p class="schedule__rule">{schedule.text}</p>}
	{schedule.kind !== "contact-secretary" && schedule.note && (
		<p class="schedule__note">{schedule.note}</p>
	)}
	{schedule.kind === "contact-secretary" && (
		<p class="schedule__none">
			Contact the secretary for meeting times.
			{contactHref && (
				<>
					{" "}
					<a href={contactHref}>Send a message</a>
				</>
			)}
		</p>
	)}
	{next.length > 0 && (
		<>
			<h3 class="schedule__next-title">Next meetings</h3>
			<ol class="schedule__next" data-testid="next-meetings">
				{next.map((o) => (
					<li>
						<time datetime={datetimeOf(o)}>{formatOccurrence(o)}</time>
					</li>
				))}
			</ol>
		</>
	)}
</div>

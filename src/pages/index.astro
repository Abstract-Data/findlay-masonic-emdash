---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entries: bodies, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("bodies", { orderBy: { display_order: "asc" } }),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<header class="band intro">
		<div class="frame">
			<h1 class="intro__title">{siteTitle}</h1>
			{siteTagline && <p class="intro__subtitle">{siteTagline}</p>}
		</div>
	</header>

	<section class="band section" aria-labelledby="bodies-heading">
		<div class="frame">
			<h2 id="bodies-heading" class="eyebrow">
				Our bodies
			</h2>
			<ul class="bodies">
				{bodies.map((body) => (
					<li>
						{body.data.name}
						{body.data.number != null && ` No. ${body.data.number}`}
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>

<style>
	.bodies {
		margin-top: var(--spacing-6);
		display: grid;
		gap: var(--spacing-3);
		font-size: var(--font-size-lg);
	}
</style>

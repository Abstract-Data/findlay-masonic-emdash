---
import { cacheRoute } from "@adapters/site/cache";
import { loadBodies } from "@adapters/site/content";
import { slugParam } from "@adapters/site/paths";
import { pageSeo } from "@adapters/site/seo";
import { getEmDashEntry, getSiteSettingsWithCacheHint } from "emdash";
import RichText from "../../components/RichText.astro";
import ContactForm from "../../components/ContactForm.astro";
import Base from "../../layouts/Base.astro";
import { resolveSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

// FR-9.1: About, Scholarships, Contact and the rest of the pages collection. The Contact page
// also carries the form that writes to any body (spec Q12).
const CONTACT_PAGE = "contact";

const slug = slugParam(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

const [settings, bodies] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	slug === CONTACT_PAGE ? loadBodies() : null,
]);
cacheRoute(Astro.cache, [cacheHint, settings.cacheHint, ...(bodies ? [bodies.hint] : [])]);
const { siteTitle } = resolveSiteIdentity(settings.data);
const seo = pageSeo(page, {
	siteTitle,
	origin: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	title: page.data.title,
	text: page.data.content ?? [],
	fallback: `${page.data.title} at the ${siteTitle}.`,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="band page">
		<div class="frame page__layout">
			<header class="page__header">
				<h1 class="page__title" {...page.edit.title}>
					{page.data.title}
				</h1>
			</header>

			<div class="prose page__body" {...page.edit.content}>
				<RichText value={page.data.content} />
			</div>
		</div>
	</article>
	{bodies && <ContactForm bodies={bodies.value.filter((body) => body.acceptsMessages)} />}
</Base>

<style>
	.page {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(4rem, 3rem + 4vw, 7rem);
	}

	.page__layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-8);
	}

	.page__title {
		font-size: var(--font-size-display);
		line-height: 1.05;
		max-width: 22ch;
	}

	@media (min-width: 960px) {
		.page__layout {
			grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--content-width));
			column-gap: clamp(2rem, 1rem + 4vw, 6rem);
		}

		.page__header {
			position: sticky;
			top: calc(var(--nav-height) + var(--spacing-8));
			align-self: start;
			container-type: inline-size;
		}

		/* Beside the body the title's column is narrow, so a title such as "Scholarships" scales to it. */
		.page__title {
			font-size: min(var(--font-size-display), 12cqi);
		}
	}
</style>

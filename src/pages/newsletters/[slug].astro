---
import { archivedEmail } from "@adapters/newsletter/archive";
import { cacheRoute, UNTAGGED } from "@adapters/site/cache";
import Base from "../../layouts/Base.astro";

// FR-6.8. The stored email is a whole HTML document from the send, so it is shown in a
// sandboxed frame (no scripts, no same-origin access) rather than spliced into this page.
const slug = Astro.params.slug ?? "";
const issue = await archivedEmail(Astro.locals, Astro.url, slug);
if (issue === null) return Astro.rewrite("/404");
cacheRoute(Astro.cache, [], UNTAGGED);
const dateFormat = new Intl.DateTimeFormat("en-US", {
	dateStyle: "long",
	timeZone: "America/New_York",
});
---

<Base
	title={issue.subject}
	description={`Findlay Masonic newsletter sent ${dateFormat.format(issue.sentAt)}.`}
>
	<article class="band section">
		<div class="frame newsletter">
			<p>
				<a href="/newsletters">
					<span class="arrow arrow--back" aria-hidden="true"></span> All newsletters
				</a>
			</p>
			<h1 class="newsletter__title">{issue.subject}</h1>
			<p class="newsletter__sent">
				Sent <time datetime={issue.sentAt.toISOString()}>{dateFormat.format(issue.sentAt)}</time>
			</p>
			<iframe
				class="newsletter__email"
				title={`${issue.subject}, as emailed`}
				srcdoc={issue.html}
				sandbox="allow-popups allow-popups-to-escape-sandbox"
				referrerpolicy="no-referrer"
				data-testid="newsletter-email"
			></iframe>
		</div>
	</article>
</Base>

<style>
	.newsletter {
		display: grid;
		gap: var(--spacing-3);
		justify-items: start;
	}

	.newsletter__title {
		font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
		line-height: 1.1;
	}

	.newsletter__sent {
		margin-bottom: var(--spacing-4);
		color: var(--color-text-secondary);
	}

	.newsletter__email {
		display: block;
		width: 100%;
		max-width: 680px;
		height: 80vh;
		border: 0;
		border-radius: var(--radius-lg);
		background: #ffffff;
		box-shadow: var(--shadow-card);
	}
</style>

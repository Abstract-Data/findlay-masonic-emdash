{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"types": ["node"],
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@core/*": ["./src/lib/core/*"],
			"@adapters/*": ["./src/lib/adapters/*"],
			"@plugins/*": ["./plugins/*"]
		}
	},
	"include": [
		"src",
		"tests",
		"*.config.ts",
		".astro/types.d.ts",
		"emdash-env.d.ts",
		"worker-configuration.d.ts"
	]
}
